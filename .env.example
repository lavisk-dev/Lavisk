# ============================================================
# Gifted — Environment Variables
# Copy this file to .env.local and fill in real values.
# The app runs with mock data when these are left blank, so
# you can develop the UI before any services are provisioned.
# ============================================================

# --- Supabase ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Payment provider switch (razorpay | cashfree | stripe) ------
PAYMENT_PROVIDER=razorpay

# --- Resend (transactional email) --------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gifted <orders@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# --- Admin auth (placeholder cookie-based gate) -------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# --- Site ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
